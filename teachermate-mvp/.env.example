# ─────────────────────────────────────────────────────────────
# TeacherMate 환경 변수 예시. 이 파일을 .env.local 로 복사해 값을 채운다.
# .env.local 은 .gitignore 에 포함되어 GitHub 에 올라가지 않는다.
#
# 아래 두 값을 비워 두면 '로컬 체험 모드'(브라우저 저장, 샘플 데이터)로 실행된다.
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (Settings > API)
VITE_SUPABASE_URL=

# Supabase anon(public) key. 공개되어도 되는 키이며, 실제 보호는 RLS 정책이 한다.
# ⚠️ service_role 키는 절대 여기에 넣지 않는다. (브라우저에 노출되면 RLS가 무력화된다)
VITE_SUPABASE_ANON_KEY=

# AI 정리 기능(Edge Function ai-flow) 버튼 표시 여부. true 일 때만 노출된다.
VITE_AI_ENABLED=false
